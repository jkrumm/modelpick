<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.modelpick-refresh</string>
  <!-- Daily `bun run refresh`: probe IU access → collect OpenRouter /
       ArtificialAnalysis / Epoch AI → recommend. The package script wraps the
       run in `secrets-run run --env-file=.env.tpl`, which resolves the keys
       from the mini's offline cache — no biometric, no network for secrets.
       Rendered by `make refresh-setup`; __HOME__ and __REPO__ are substituted. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>run</string>
    <string>refresh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- launchd sets no shell PATH: bun and the secrets-run shim must be
       reachable by absolute directory, or the job dies at spawn (exit 127)
       and every scheduled run fails silently. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <!-- Fire only on schedule: a reload must not spend a refresh, and the
       refresh exits 1 on a failed step, which KeepAlive would retry forever. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/modelpick-refresh.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/modelpick-refresh.err</string>
</dict>
</plist>
