# modelpick — env template. Copy to .env and fill in (or resolve from 1Password).
# .env is gitignored. NEVER commit real values (public repo).

# IU unified endpoint (native per-provider gateway) — op://common/anthropic (account tkrumm)
# Host: https://unified-endpoint-main.app.iu-it.org — each provider has its own route/dialect.
IU_API_KEY=
IU_OPENAI_BASE_URL=          # …/openai/v1     (OpenAI + audio + embeddings + litellm aliases)
IU_ANTHROPIC_BASE_URL=       # …/anthropic/v1  (native Anthropic Messages API)
IU_GEMINI_BASE_URL=          # …/gemini/v1beta (native Gemini generateContent)

# Local SQLite database (libsql). Optional — defaults to file:modelpick.db in
# the repo root (gitignored). `make db-push` creates/syncs it from the schema.
DATABASE_URL=file:modelpick.db

# External leaderboard APIs
OPENROUTER_API_KEY=          # https://openrouter.ai/keys
ARTIFICIALANALYSIS_API_KEY=  # https://artificialanalysis.ai/api-reference

# Admin gate — lightweight client-side key (NOT real auth)
ADMIN_KEY=

# Audio demo storage — absolute path where MP3s are written (optional, defaults to <cwd>/public/demos)
DEMOS_DIR=
