# modelpick — production env template.
# On the VPS: managed via apps/modelpick/.env.tpl (op:// references).
# Copy this to apps/modelpick/.env.tpl on the VPS and fill in 1Password paths.
# NEVER commit real values.

# IU unified endpoint — op://common/anthropic (account tkrumm)
IU_API_KEY=op://common/anthropic/IU_API_KEY
IU_BASE_URL=op://common/anthropic/IU_BASE_URL
IU_OPENAI_BASE_URL=op://common/anthropic/IU_OPENAI_BASE_URL

# Shared VPS Postgres — own schema `modelpick`, schema-scoped user
# Host is `postgres` (Docker service name on postgres-net).
DATABASE_URL=postgresql://modelpick:${MODELPICK_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=modelpick
POSTGRES_DB=op://vps/config/POSTGRES_DB
MODELPICK_DB_PASSWORD=op://vps/modelpick/DB_PASSWORD

# External leaderboard APIs — op://vps/modelpick api secrets
OPENROUTER_API_KEY=op://vps/modelpick api secrets/OPENROUTER_API_KEY
ARTIFICIALANALYSIS_API_KEY=op://vps/modelpick api secrets/ARTIFICIALANALYSIS_API_KEY

# Admin gate — lightweight client-side key (NOT real auth)
ADMIN_KEY=op://vps/modelpick/ADMIN_KEY

# Audio demo storage — absolute path inside the container (volume-mounted)
DEMOS_DIR=/app/public/demos
