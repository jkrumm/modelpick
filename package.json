{
  "name": "modelpick",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "npx kill-port 7727 && scripts/with-keys vite dev",
    "build": "vite build",
    "start": "scripts/with-keys node --import ./scripts/exit-guard.mjs .output/server/index.mjs",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt 'src/**' --write",
    "format:check": "oxfmt 'src/**' --check",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed-run.ts",
    "models": "scripts/with-keys bun run scripts/sync-catalog.ts",
    "import:replicate": "scripts/with-keys bun run scripts/import-replicate.ts",
    "demos:seed": "scripts/with-keys bun run scripts/seed-demos.ts",
    "probe": "scripts/with-keys bun run scripts/probe.ts",
    "collect": "scripts/with-keys bun run scripts/collect.ts",
    "alerts": "scripts/with-keys bun run scripts/release-alerts.ts",
    "refresh": "scripts/with-keys bun run scripts/refresh.ts",
    "benchmark": "scripts/with-keys bun run scripts/benchmark-throughput.ts",
    "bench": "scripts/with-keys bun run scripts/bench.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "drizzle-orm": "^0.45.4",
    "hyparquet": "1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
