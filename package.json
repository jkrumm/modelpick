{
  "name": "modelpick",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "npx kill-port 7727 && secrets-run run --env-file=.env.tpl -- vite dev",
    "build": "vite build",
    "start": "secrets-run run --env-file=.env.tpl -- node --import ./scripts/exit-guard.mjs .output/server/index.mjs",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt 'src/**' --write",
    "format:check": "oxfmt 'src/**' --check",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed-run.ts",
    "import:replicate": "secrets-run run --env-file=.env.tpl -- bun run scripts/import-replicate.ts",
    "demos:seed": "secrets-run run --env-file=.env.tpl -- bun run scripts/seed-demos.ts",
    "probe": "secrets-run run --env-file=.env.tpl -- bun run scripts/probe.ts",
    "collect": "secrets-run run --env-file=.env.tpl -- bun run scripts/collect.ts",
    "recommend": "secrets-run run --env-file=.env.tpl -- bun run scripts/recommend.ts",
    "refresh": "secrets-run run --env-file=.env.tpl -- bun run scripts/refresh.ts",
    "benchmark": "secrets-run run --env-file=.env.tpl -- bun run scripts/benchmark-throughput.ts",
    "benchmark:tools": "secrets-run run --env-file=.env.tpl -- bun run scripts/benchmark-tool-calling.ts",
    "benchmark:bakeoff": "secrets-run run --env-file=.env.tpl -- bun run scripts/benchmark-bakeoff.ts",
    "bench:fast": "secrets-run run --env-file=.env.tpl -- bun run scripts/bench-fast.ts",
    "pick": "secrets-run run --env-file=.env.tpl -- bun run scripts/pick.ts",
    "cap": "bun run scripts/cap.ts",
    "route-map": "secrets-run run --env-file=.env.tpl -- bun run scripts/route-map.ts",
    "bench": "secrets-run run --env-file=.env.tpl -- bun run scripts/bench.ts",
    "benchmark:crossprovider": "secrets-run run --env-file=.env.tpl -- bun run scripts/benchmark-crossprovider.ts",
    "verify-deployments": "bun run scripts/verify-deployments.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.56",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/threshold": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.38",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
