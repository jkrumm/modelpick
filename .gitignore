# Secrets — NEVER commit. Public repo + autonomous loop = hard rule.
.env
.env.*
!.env.tpl
*.local
secrets/
*.key
*.pem

# Local SQLite database (libsql) + its WAL/SHM sidecars
modelpick.db
modelpick.db-*
*.sqlite
*.sqlite-*

# Dependencies / build
node_modules/
dist/
.output/
.vinxi/
.nitro/
.tanstack/
.cache/
build/

# Generated audio demos (dev) — hosted as assets, not tracked
public/demos/*.mp3
public/demos/*.wav

# Logs / OS
*.log
.DS_Store
.idea/
.vscode/

# ccbench raw stream-json transcripts — megabytes per suite, and reproducible.
# The graded summary each run writes is tracked; the transcripts are not.
docs/experiments/ccbench/**/*.jsonl

# ccbench isolated Claude config (recreated by scripts/bench.ts on every run)
.ccbench-config/
